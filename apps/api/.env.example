# Copie para .env (fora do git). Os valores abaixo já servem para o docker-compose local.
PORT=3333
# Origens do front liberadas no CORS (separadas por vírgula).
WEB_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:3333

# Local: Postgres do docker-compose. Produção (Neon): a string "pooled" (host com -pooler) e ?sslmode=require
DATABASE_URL=postgres://psjb:psjb@localhost:5432/psjb_cantos
DATABASE_POOL_MAX=5

# Gere com: openssl rand -base64 48
JWT_SECRET=dev-only-secret-troque-em-producao-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TTL_SHORT_DAYS=1
REFRESH_TTL_LONG_DAYS=30

# Vercel Blob (fotos). Sem o token, os arquivos vão para apps/api/uploads/.
# BLOB_READ_WRITE_TOKEN=

# Seed (npm run db:seed -w api). Em produção, a senha é obrigatória.
# SEED_ADMIN_EMAIL=superadmin@psjb.org.br
# SEED_ADMIN_PASSWORD=
