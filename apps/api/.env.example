# Copie para .env (fora do git). Os valores abaixo já servem para o docker-compose local.
PORT=3333
# Origens do front liberadas no CORS (separadas por vírgula).
WEB_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:3333

# Local: Postgres do docker-compose. Produção (Neon): a string "pooled" (host com -pooler) e ?sslmode=require
DATABASE_URL=postgres://psjb:psjb@localhost:5432/psjb_cantos
DATABASE_POOL_MAX=5

# Gere com: openssl rand -base64 48
JWT_SECRET=dev-only-secret-troque-em-producao-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TTL_SHORT_DAYS=1
REFRESH_TTL_LONG_DAYS=30

# Vercel Blob (fotos). Sem o token, os arquivos vão para apps/api/uploads/.
# BLOB_READ_WRITE_TOKEN=

# Deploy Hook do projeto do front na Vercel (Settings › Git › Deploy Hooks).
# O botão "Publicar no site" do admin de cantos chama esta URL para gerar o site de novo.
# SITE_DEPLOY_HOOK_URL=

# Endereço do site (com o basePath, se houver), usado nos links dos e-mails.
APP_URL=http://localhost:3000

# E-mail (Resend). Sem a chave, os e-mails só aparecem no terminal da API (com o link ou o código).
# Em produção a chave é obrigatória. Pelo Marketplace da Vercel (Resend), ela vem pronta no projeto.
# RESEND_API_KEY=
# Sem domínio verificado no Resend, só funciona o remetente de teste, e só para o e-mail da sua conta.
# EMAIL_FROM=Cantos PSJB <nao-responda@psjb.org.br>
# EMAIL_FROM=Cantos PSJB <onboarding@resend.dev>

# Login em duas etapas (código por e-mail). Padrão: ligado em produção, desligado fora dela.
# LOGIN_2FA=true

# Seed (npm run db:seed -w api). Em produção, a senha é obrigatória.
# SEED_ADMIN_EMAIL=superadmin@psjb.org.br
# SEED_ADMIN_PASSWORD=
